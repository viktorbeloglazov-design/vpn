<Window x:Class="QPVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QP VPN" Height="780" Width="460"
        MinHeight="620" MinWidth="420"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnFileDropped" DragOver="OnDragOver">

    <Window.Resources>
        <!-- Переключатель: тот же вид, что на телефоне. -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="46" Height="26" CornerRadius="13"
                                Background="{StaticResource SurfaceVariant}"
                                BorderBrush="{StaticResource Outline}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="{StaticResource Muted}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Ocean}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Sky}" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,18">
        <StackPanel>

            <!-- Фирменная шапка -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                <Image x:Name="Logo" Source="Assets/logo-dark.png" Height="42" Margin="0,0,0,8" />
                <TextBlock Text="Premium VPN" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Sky}" HorizontalAlignment="Center" />
                <TextBlock Text="Special for Kupibas Group" FontSize="11"
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Включение -->
            <Border Style="{StaticResource Card}">
                <StackPanel HorizontalAlignment="Center">
                    <Button x:Name="PowerButton" Click="OnPowerClicked" Width="132" Height="132"
                            Margin="0,4,0,10" Background="{StaticResource SurfaceVariant}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="Ring" Fill="{TemplateBinding Background}"
                                             Stroke="{StaticResource Outline}" StrokeThickness="2" />
                                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="15" FontWeight="SemiBold" TextAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Sky}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        Включить
                    </Button>

                    <TextBlock x:Name="StateTitle" Text="Выключен" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="StateSubtitle" Style="{StaticResource Hint}" Text="Профиль не загружен"
                               HorizontalAlignment="Center" TextAlignment="Center" />

                    <Grid Margin="0,12,0,0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="ПРИНЯТО" FontSize="10" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="RxText" Text="—" FontSize="14" FontFamily="Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ОТПРАВЛЕНО" FontSize="10" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="TxText" Text="—" FontSize="14" FontFamily="Consolas" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Как идёт трафик: настраивать нечего, маршрутизация зашита -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Как идёт трафик" Style="{StaticResource Title}" />
                    <TextBlock Style="{StaticResource Hint}" Text="Настраивать ничего не нужно" />
                    <TextBlock Text="Заблокированные сервисы — через VPN, казахстанский адрес"
                               Foreground="{StaticResource OnSurface}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="MasterText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    <TextBlock x:Name="MasterHint" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Рабочие ресурсы -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Рабочие ресурсы" Style="{StaticResource Title}" />
                            <TextBlock x:Name="WorkHint" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <CheckBox x:Name="WorkFilterSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                  Checked="OnWorkFilterChanged" Unchecked="OnWorkFilterChanged" />
                    </Grid>
                    <TextBlock x:Name="WorkList" Style="{StaticResource Hint}" FontFamily="Consolas" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Ключ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Ключ доступа" Style="{StaticResource Title}" />
                    <TextBlock x:Name="ProfileText" Style="{StaticResource Hint}" />
                    <Button Content="Вставить ключ vpn:// из буфера" Click="OnPasteKey" />
                    <Button Content="Открыть файл .conf или картинку с QR-кодом" Click="OnOpenFile" />
                    <Button x:Name="ClearProfileButton" Content="Удалить ключ" Click="OnClearProfile" />
                    <TextBlock x:Name="ImportNote" Style="{StaticResource Hint}" Margin="0,8,0,0" />

                    <TextBlock Text="Запасной вход" Foreground="{StaticResource OnSurface}" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="Необязательно. Адрес узла-пересыльщика в виде адрес:порт. Программа пробует сервер напрямую, а если он не ответит — этот узел. Ключ менять не нужно." />
                    <TextBox x:Name="BackupEndpointBox" Margin="0,6,0,0" Padding="6"
                             Background="{StaticResource SurfaceVariant}" Foreground="{StaticResource OnSurface}"
                             BorderThickness="0" LostFocus="OnBackupEndpointChanged" />
                </StackPanel>
            </Border>

            <!-- Обновление -->
            <Border x:Name="UpdateCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="UpdateTitle" Style="{StaticResource Title}" Text="Вышла новая версия" />
                    <TextBlock x:Name="UpdateHint" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                    <Button x:Name="UpdateButton" Content="Обновить" Click="OnInstallUpdate" />
                </StackPanel>
            </Border>

            <!-- Скорость -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Скорость" Style="{StaticResource Title}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Через VPN и без него — на одной и той же закачке" />
                    <TextBlock x:Name="SpeedText" Style="{StaticResource Hint}" FontFamily="Consolas"
                               Margin="0,8,0,0" />
                    <TextBlock x:Name="SpeedHint" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                    <Button x:Name="SpeedButton" Content="Замерить скорость" Click="OnMeasureSpeed" />

                    <TextBlock Text="Размер пакета (MTU)" Foreground="{StaticResource OnSurface}"
                               Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="В гостевых и мобильных сетях большие пакеты часто не проходят целиком: сообщения уходят, а видео крутится и не качается. На «Авто» программа подбирает размер сама." />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="MtuKey" GroupName="Mtu" Foreground="{StaticResource OnSurface}"
                                     Content="Авто" Checked="OnMtuChanged" Margin="0,0,14,0" />
                        <RadioButton x:Name="Mtu1420" GroupName="Mtu" Foreground="{StaticResource OnSurface}"
                                     Content="1420" Checked="OnMtuChanged" Margin="0,0,14,0" />
                        <RadioButton x:Name="Mtu1380" GroupName="Mtu" Foreground="{StaticResource OnSurface}"
                                     Content="1380" Checked="OnMtuChanged" Margin="0,0,14,0" />
                        <RadioButton x:Name="Mtu1280" GroupName="Mtu" Foreground="{StaticResource OnSurface}"
                                     Content="1280" Checked="OnMtuChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Проверка -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Проверка" Style="{StaticResource Title}" />
                    <TextBlock Style="{StaticResource Hint}" Text="Посмотрите, из какой страны вас видят сайты." />
                    <Button x:Name="CheckIpButton" Content="Проверить мой IP" Click="OnCheckIp" />
                    <TextBlock x:Name="IpText" Style="{StaticResource Hint}" Margin="0,8,0,0" />

                    <TextBlock Text="Обновление" Foreground="{StaticResource OnSurface}" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="Программа сама смотрит раз в сутки, не вышла ли новая версия. Здесь можно спросить прямо сейчас." />
                    <Button x:Name="CheckUpdateButton" Content="Проверить обновления" Click="OnCheckUpdate" />
                    <TextBlock x:Name="UpdateStateText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
