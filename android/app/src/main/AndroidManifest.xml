<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Приложение ставится файлом, мимо магазина: обновляет оно себя само. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Чтобы показать список программ и чтобы система призналась, что МАХ и
      прочие установлены: без этого getPackageInfo врёт про отсутствие.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="ru.oneme.app" />
        <package android:name="ru.oneme.app.beta" />
        <package android:name="ru.ok.messages" />
        <package android:name="ru.rostel" />
        <package android:name="ru.gosuslugi.doc" />
        <package android:name="ru.gosuslugi.goskey" />
        <package android:name="ru.fns.billsCheck" />
        <package android:name="com.nalog.lkfl2" />
        <package android:name="ru.sberbankmobile" />
        <package android:name="ru.sberbank.sbol" />
        <package android:name="com.idamob.tinkoff.android" />
        <package android:name="ru.vtb24.mobilebanking.android" />
        <package android:name="ru.alfabank.mobile.android" />
        <package android:name="ru.raiffeisennews" />
        <package android:name="ru.gazprombank.android.mobilebank.app" />
        <package android:name="ru.psbank.mobile" />
        <package android:name="ru.mkb.mobile" />
        <package android:name="ru.rshb.mbank" />
        <package android:name="ru.otpbank.mobile" />
        <package android:name="ru.nspk.mirpay" />
        <package android:name="ru.nspk.sbpay" />
        <package android:name="ru.mts.mymts" />
        <package android:name="ru.megafon.mlk" />
        <package android:name="ru.beeline.services" />
        <package android:name="ru.tele2.mytele2" />
        <package android:name="ru.mos.polis" />
        <package android:name="ru.mos.mospolytech" />
    </queries>

    <application
        android:name=".QpVpnApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.QpVpn">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Ссылка вида vpn://… — ею делится Amnezia. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vpn" />
            </intent-filter>

            <!-- «Поделиться» текстом или файлом настроек. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
          Отдаёт скачанную сборку системному установщику: напрямую файлом
          из своего каталога Android делиться не разрешает.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Кнопка «Отключить» в уведомлении о работающем туннеле. -->
        <receiver
            android:name=".vpn.DisconnectReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="kz.qpvpn.action.DISCONNECT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
