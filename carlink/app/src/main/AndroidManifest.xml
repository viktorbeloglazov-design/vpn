<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.usb.accessory" android:required="true" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Чтобы показать номер телефона для регистрации несертифицированной прошивки. -->
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Нужно, чтобы отдать в машину звук, который играет телефон. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Начиная с Android 11 чужие пакеты не видны, пока их не перечислишь.
        Нам нужно знать, стоят ли сервисы Google и Android Auto.
    -->
    <queries>
        <package android:name="com.google.android.gsf" />
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".CarLinkApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_directions"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.CarLink">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Машина по USB объявляет себя «аксессуаром» (протокол AOAP) с
                именем Android Auto. Android запускает то приложение, которое
                подписалось на это имя. Если на телефоне есть сервисы Google,
                на это же имя подписан и настоящий Android Auto — тогда система
                спросит, чем открывать.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/usb_accessory_filter" />
        </activity>

        <service
            android:name=".CarLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|mediaProjection" />

        <!--
            Служба специальных возможностей — единственный способ без root
            передать нажатия с экрана машины в обычные программы телефона.
            Нужна только в режиме «зеркало экрана».
        -->
        <service
            android:name=".projection.TouchInjector"
            android:exported="false"
            android:label="@string/injector_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/touch_injector_config" />
        </service>
    </application>
</manifest>
